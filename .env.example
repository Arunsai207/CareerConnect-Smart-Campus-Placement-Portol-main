MONGODB_URI=mongodb://127.0.0.1:27017/studentDB
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Authenticated SMTP settings used for registration OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-provider-app-password
EMAIL_FROM=your-email@example.com

# Optional backend SMS delivery webhook used for notification channels.
SMS_WEBHOOK_URL=

# Keep automatic Streamlit startup disabled when only testing the Node server
START_STREAMLIT=false
