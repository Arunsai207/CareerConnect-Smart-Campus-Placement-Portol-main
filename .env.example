# Copy this file to .env and set your real API key
# Do NOT commit your real .env to version control

# Required for the country/state/city dropdowns (https://countrystatecity.in/)
CSC_KEY=YOUR_REAL_COUNTRYSTATECITY_API_KEY

# Optional: change server port
# PORT=3000

# Optional: enable the AI chat assistant with Gemini or OpenAI
# GEMINI_API_KEY=your_gemini_api_key_here
# API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
